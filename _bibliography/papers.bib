@misc{qi2026flowarbrep,
  abbr        = {SIGGRAPH Asia},
  bibtex_show = {true},
  selected    = {true},
  title       = {FlowAR-BRep: Single-Stage Autoregressive Generation of CAD B-Rep with Flow Matching},
  author      = {Qi, Yongkang and others},
  year        = {2026},
  note        = {Accepted at SIGGRAPH Asia 2026},
  abstract    = {A single-stage generative framework for CAD Boundary Representation (B-Rep) that jointly models discrete topology and continuous parametric geometry within a single Transformer backbone. Building on the Transfusion paradigm, it encodes topology and geometry into one interleaved sequence, drops lossy VQ-VAE discretization, and generates parametric geometry directly with a Flow-Matching (x-prediction) head while a classification head predicts topology tokens. A finite-state machine with graphics validation enables backtracking and resampling for validity, and sequence packing with variable-length attention improves training efficiency on 4x RTX 5090. The model supports point-cloud / image / text-conditioned generation and reaches state-of-the-art unconditional generation on public benchmarks with markedly higher validity and ~2.8x inference speedup.}
}
